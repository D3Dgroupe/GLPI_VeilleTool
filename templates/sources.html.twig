{#
 # Plugin GLPI « Outils de Veille » (veilletool)
 # Onglet « Flux RSS / ATOM » : flux d'alimentation de l'observatoire.
 #}

{% set list_url = path('/plugins/veilletool/front/source.php') %}
{% set form_url = path('/plugins/veilletool/front/source.form.php') %}

<div class="veille-sources">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="mb-0">
            <i class="ti ti-rss me-1"></i>{{ __('Flux RSS / ATOM', 'veilletool') }}
            {% if total_count > 0 %}
                <span class="badge bg-secondary-lt ms-2"
                      title="{{ __('Flux actifs sur le total défini.', 'veilletool') }}">
                    {{ active_count }} / {{ total_count }}
                </span>
            {% endif %}
        </h2>

        <div class="d-flex flex-wrap gap-2">
            {% if can_create %}
                <a class="btn btn-primary" href="{{ form_url }}">
                    <i class="ti ti-plus me-1"></i>{{ __('Ajouter un flux', 'veilletool') }}
                </a>
            {% endif %}
            {% if can_update %}
                <form method="post" action="{{ list_url }}" class="d-inline">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <button type="submit" name="refresh_all" value="1" class="btn btn-outline-secondary">
                        <i class="ti ti-refresh me-1"></i>{{ __('Collecter maintenant', 'veilletool') }}
                    </button>
                </form>
            {% endif %}
            <a class="btn btn-outline-secondary" href="{{ path('/plugins/veilletool/front/category.php') }}">
                <i class="ti ti-tags me-1"></i>{{ __('Catégories', 'veilletool') }}
            </a>
        </div>
    </div>

    {# ---------------------------------------------------------------- #}
    {# État réel de la tâche automatique                                 #}
    {# ---------------------------------------------------------------- #}
    {% set cron_class = 'alert-info' %}
    {% if not cron.exists or not cron.enabled %}
        {% set cron_class = 'alert-warning' %}
    {% endif %}

    <div class="alert {{ cron_class }} d-flex flex-wrap align-items-center gap-2">
        <i class="ti {{ cron.exists and cron.enabled ? 'ti-clock-play' : 'ti-alert-triangle' }}"></i>

        <div class="flex-fill">
            {% if not cron.exists %}
                {{ __('La tâche automatique de collecte est introuvable. Réinstallez le plugin pour la recréer.', 'veilletool') }}
            {% elseif not cron.enabled %}
                {{ __('La collecte automatique est désactivée : les flux ne seront relevés que manuellement.', 'veilletool') }}
            {% else %}
                {{ __('Collecte automatique %1$s, en mode %2$s.', 'veilletool')|format(cron.frequency, cron.mode) }}
                {% if cron.lastrun %}
                    <span class="text-secondary">
                        {{ __('Dernière exécution :', 'veilletool') }} {{ cron.lastrun|formatted_datetime }}
                    </span>
                {% else %}
                    <span class="text-secondary">{{ __('Jamais exécutée pour le moment.', 'veilletool') }}</span>
                {% endif %}

                {% if cron.is_cli %}
                    <div class="small mt-1">
                        {{ __('Le mode CLI suppose qu\'un cron système appelle GLPI. À défaut, la tâche ne se déclenchera jamais : basculez-la en mode GLPI.', 'veilletool') }}
                    </div>
                {% endif %}
            {% endif %}
        </div>

        {% if can_config %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path(cron.url) }}">
                <i class="ti ti-settings me-1"></i>{{ __('Paramètres de la tâche', 'veilletool') }}
            </a>
        {% endif %}
    </div>

    {# ---------------------------------------------------------------- #}
    {# Rapport de diagnostic                                             #}
    {#                                                                   #}
    {# « Délai dépassé » ne dit pas où : la résolution du nom, la         #}
    {# connexion et le téléchargement échouent du même mot. Les trois     #}
    {# sont donc présentés séparément.                                    #}
    {# ---------------------------------------------------------------- #}
    {% if diagnosis is not null %}
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-stethoscope me-1"></i>
                    {{ __('Diagnostic : %s', 'veilletool')|format(diagnosis.source) }}
                </h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <tbody>
                        {% for step in diagnosis.steps %}
                            <tr>
                                <td style="width: 2.5rem;">
                                    {% if step.ok %}
                                        <i class="ti ti-circle-check text-green"></i>
                                    {% else %}
                                        <i class="ti ti-circle-x text-danger"></i>
                                    {% endif %}
                                </td>
                                <td style="width: 12rem;"><strong>{{ step.step }}</strong></td>
                                <td class="{{ step.ok ? 'text-secondary' : 'text-danger' }}">{{ step.detail }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {#
     # Les flux du catalogue arrivent désactivés : sans ce rappel, on peut
     # croire la veille en panne alors que rien n'a encore été mis en route.
     #}
    {% if total_count > 0 and active_count == 0 %}
        <div class="alert alert-warning d-flex align-items-center">
            <i class="ti ti-player-pause me-2"></i>
            <span>
                {{ __('Aucun flux n\'est actif : rien ne sera collecté. Activez ceux que vous souhaitez suivre dans la colonne « Actif ».', 'veilletool') }}
            </span>
        </div>
    {% endif %}

    {# ---------------------------------------------------------------- #}
    {# Moteur de recherche                                               #}
    {#                                                                   #}
    {# Un catalogue de quarante flux ne se parcourt pas : il se cherche. #}
    {# Le mot clé porte aussi sur la description, ce qui permet de       #}
    {# retrouver un flux par ce qu'il publie plutôt que par son nom.     #}
    {# ---------------------------------------------------------------- #}
    {% if total_count > 0 %}
        <form method="get" action="{{ list_url }}" class="card card-sm mb-3" data-veille-filters>
            <div class="card-body row g-2 align-items-end">
                <div class="col-12 col-md-5">
                    <label class="form-label" for="veille-src-q">{{ __('Mot clé', 'veilletool') }}</label>
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                        <input type="text" id="veille-src-q" name="q" class="form-control"
                               value="{{ search.keyword }}"
                               placeholder="{{ __('Nom, adresse, description...', 'veilletool') }}">
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label" for="veille-src-cat">{{ __('Catégorie', 'veilletool') }}</label>
                    <select id="veille-src-cat" name="cat" class="form-select">
                        <option value="0">{{ __('Toutes les catégories', 'veilletool') }}</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}"
                                {{ search.category == category.id ? 'selected' : '' }}>{{ category.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label" for="veille-src-active">{{ __('Actif') }}</label>
                    <select id="veille-src-active" name="active" class="form-select">
                        <option value="">{{ __('Actifs et inactifs', 'veilletool') }}</option>
                        <option value="1" {{ search.active == '1' ? 'selected' : '' }}>{{ __('Actifs seulement', 'veilletool') }}</option>
                        <option value="0" {{ search.active == '0' ? 'selected' : '' }}>{{ __('Inactifs seulement', 'veilletool') }}</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label" for="veille-src-cards">{{ __('Cartes', 'veilletool') }}</label>
                    <select id="veille-src-cards" name="cards" class="form-select">
                        {% for value, label in volume_filters %}
                            <option value="{{ value }}" {{ search.volume == value ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-filter me-1"></i>{{ __('Rechercher', 'veilletool') }}
                    </button>
                    <a class="btn btn-ghost-secondary" href="{{ list_url }}">
                        {{ __('Réinitialiser', 'veilletool') }}
                    </a>
                    <span class="text-secondary ms-auto">
                        {{ _n('%d flux affiché', '%d flux affichés', sources|length, 'veilletool')|format(sources|length) }}
                        {% if sources|length != total_count %}
                            <span class="text-secondary">/ {{ total_count }}</span>
                        {% endif %}
                    </span>
                </div>
            </div>
        </form>
    {% endif %}

    {# ---------------------------------------------------------------- #}
    {# Liste des sources                                                 #}
    {# ---------------------------------------------------------------- #}
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover card-table">
                <thead>
                    <tr>
                        <th>{{ __('Name') }}</th>
                        <th>{{ _n('Type', 'Types', 1) }}</th>
                        <th>{{ __('Catégories', 'veilletool') }}</th>
                        <th>{{ __('Actif') }}</th>
                        <th>{{ __('Dernière collecte', 'veilletool') }}</th>
                        <th class="text-end">{{ __('Intérêt', 'veilletool') }}</th>
                        <th class="text-end">{{ __('Cartes', 'veilletool') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for source in sources %}
                        <tr>
                            <td>
                                <a href="{{ form_url }}?id={{ source.id }}"><strong>{{ source.name }}</strong></a>
                                {#
                                 # La description dit ce que le flux publie :
                                 # c'est elle qui permet d'activer en
                                 # connaissance de cause, sans ouvrir chaque
                                 # adresse.
                                 #}
                                {% if source.comment is not empty %}
                                    <div class="veille-source-desc small">{{ source.comment }}</div>
                                {% endif %}
                                {% if source.url is not empty %}
                                    <div class="text-secondary small text-truncate" style="max-width: 32rem;">
                                        {{ source.url }}
                                    </div>
                                {% endif %}
                            </td>
                            <td><i class="{{ source.type_icon }} me-1"></i>{{ source.type_label }}</td>
                            <td>
                                {% for category in source.categories %}
                                    <span class="badge veille-badge" style="background-color: {{ category.color }}; color: {{ category.text_color }}">
                                        <i class="{{ category.icon }}"></i>{{ category.name }}
                                    </span>
                                {% else %}
                                    <span class="text-secondary">-</span>
                                {% endfor %}
                            </td>
                            {#
                             # L'activité se bascule depuis la liste : le
                             # catalogue livré arrive entièrement désactivé, et
                             # ouvrir quarante fiches pour en activer cinq
                             # n'aurait aucun sens.
                             #}
                            <td>
                                {% if can_update %}
                                    <form method="post" action="{{ list_url }}" class="d-inline">
                                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                        <button type="submit" name="toggle_active" value="{{ source.id }}"
                                                class="btn btn-sm {{ source.is_active ? 'btn-success' : 'btn-outline-secondary' }}"
                                                title="{{ source.is_active
                                                    ? __('Désactiver ce flux', 'veilletool')
                                                    : __('Activer ce flux', 'veilletool') }}">
                                            <i class="ti {{ source.is_active ? 'ti-player-play' : 'ti-player-pause' }} me-1"></i>
                                            {{ source.is_active ? __('Yes') : __('No') }}
                                        </button>
                                    </form>
                                {% elseif source.is_active %}
                                    <span class="badge bg-green-lt">{{ __('Yes') }}</span>
                                {% else %}
                                    <span class="badge bg-secondary-lt">{{ __('No') }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if source.last_import %}
                                    {{ source.last_import|formatted_datetime }}
                                    <div class="small {{ source.last_status == 'error' ? 'text-danger' : 'text-secondary' }}">
                                        {{ source.last_message }}
                                    </div>
                                {% else %}
                                    <span class="text-secondary">{{ __('Jamais', 'veilletool') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <span class="badge bg-secondary-lt"
                                      title="{{ __('Composante « source » du score d\'intérêt des cartes de ce flux.', 'veilletool') }}">
                                    {{ source.interest }}
                                </span>
                            </td>
                            <td class="text-end">{{ source.article_count }}</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    {% if can_update and source.can_collect %}
                                        <form method="post" action="{{ list_url }}" class="d-inline">
                                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                            <input type="hidden" name="id" value="{{ source.id }}">
                                            <button type="submit" name="refresh" value="1"
                                                    class="btn btn-sm btn-ghost-secondary"
                                                    title="{{ __('Collecter ce flux', 'veilletool') }}">
                                                <i class="ti ti-refresh"></i>
                                            </button>
                                        </form>
                                    {% endif %}

                                    {% if can_update and source.can_collect %}
                                        <form method="post" action="{{ list_url }}" class="d-inline">
                                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                            <button type="submit" name="diagnose" value="{{ source.id }}"
                                                    class="btn btn-sm btn-ghost-secondary"
                                                    title="{{ __('Diagnostiquer la connexion à ce flux', 'veilletool') }}">
                                                <i class="ti ti-stethoscope"></i>
                                            </button>
                                        </form>
                                    {% endif %}

                                    <a class="btn btn-sm btn-ghost-secondary" href="{{ form_url }}?id={{ source.id }}"
                                       title="{{ __('Modifier', 'veilletool') }}">
                                        <i class="ti ti-edit"></i>
                                    </a>

                                    {% if can_purge %}
                                        <form method="post" action="{{ list_url }}" class="d-inline"
                                              onsubmit="return confirm('{{ __('Supprimer ce flux ainsi que toutes ses cartes ?', 'veilletool')|e('js') }}');">
                                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                            <input type="hidden" name="id" value="{{ source.id }}">
                                            <button type="submit" name="purge" value="1"
                                                    class="btn btn-sm btn-ghost-danger"
                                                    title="{{ __('Supprimer', 'veilletool') }}">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-secondary text-center py-4">
                                {% if total_count > 0 %}
                                    {{ __('Aucun flux ne correspond à cette recherche.', 'veilletool') }}
                                {% else %}
                                    {{ __('Aucun flux n\'est encore défini. Chargez le catalogue livré ci-dessous, ou ajoutez un flux.', 'veilletool') }}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ---------------------------------------------------------------- #}
    {# Catalogue livré et import CSV                                     #}
    {# ---------------------------------------------------------------- #}
    {% if can_create %}
        <div class="row row-cards">
            {% if catalog_count > 0 %}
                <div class="col-12 col-lg-6 d-flex">
                    <div class="card flex-fill">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="ti ti-books me-1"></i>{{ __('Catalogue livré', 'veilletool') }}
                            </h3>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="text-secondary">
                                {{ __('Une sélection de %d flux de veille cyber, IT et réglementaire : CERT et autorités, avis d\'éditeurs, presse spécialisée, infrastructure et cloud.', 'veilletool')|format(catalog_count) }}
                            </p>
                            <p class="text-secondary">
                                <i class="ti ti-player-pause me-1"></i>
                                {{ __('Les flux ajoutés sont tous désactivés : vous activez ensuite ceux qui vous intéressent. Les flux déjà définis ne sont pas dupliqués.', 'veilletool') }}
                            </p>
                            <small class="form-hint mb-3">
                                {{ __('Les adresses de flux changent au fil du temps : vérifiez la première collecte d\'un flux que vous venez d\'activer.', 'veilletool') }}
                            </small>

                            <form method="post" action="{{ list_url }}" class="mt-auto">
                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                <button type="submit" name="load_catalog" value="1" class="btn btn-primary">
                                    <i class="ti ti-download me-1"></i>{{ __('Charger le catalogue', 'veilletool') }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="col-12 col-lg-6 d-flex">
                <div class="card flex-fill">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="ti ti-file-upload me-1"></i>{{ __('Importer une liste de flux', 'veilletool') }}
                        </h3>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <form method="post" action="{{ list_url }}" enctype="multipart/form-data"
                              class="d-flex flex-column flex-fill">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

                            <p class="text-secondary mb-2">
                                {{ __('Fichier CSV encodé en UTF-8, séparateur point-virgule :', 'veilletool') }}
                            </p>
                            <p class="mb-2">
                                <code>{{ constant('GlpiPlugin\\Veilletool\\Feed\\SourceCatalog::CSV_HEADER') }}</code>
                            </p>
                            <small class="form-hint mb-3">
                                {{ __('Seules les deux premières colonnes sont obligatoires. Type vaut « rss » ou « atom ». Thèmes reprend les codes des catégories de veille, séparés par une barre verticale. Intérêt va de 0 à 100. Actif laissé vide vaut désactivé. La première ligne peut être un en-tête, et les flux déjà connus sont ignorés.', 'veilletool') }}
                            </small>

                            <div class="mb-3">
                                <input type="file" name="csvfile" class="form-control"
                                       accept=".csv,text/csv" required>
                            </div>

                            <button type="submit" name="import" value="1" class="btn btn-primary mt-auto align-self-start">
                                <i class="ti ti-upload me-1"></i>{{ __('Importer', 'veilletool') }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ---------------------------------------------------------------- #}
    {# Suppression de masse                                              #}
    {#                                                                   #}
    {# Supprimer un flux emporte toutes ses cartes : le décompte         #}
    {# préalable porte sur les deux, et l'action reprend exactement les  #}
    {# critères affichés - d'où les champs cachés, qui renvoient la      #}
    {# recherche en POST.                                                #}
    {# ---------------------------------------------------------------- #}
    {% if can_purge and total_count > 0 %}
        <div class="card border-danger mt-3">
            <div class="card-header">
                <h3 class="card-title text-danger">
                    <i class="ti ti-trash me-1"></i>{{ __('Supprimer des flux', 'veilletool') }}
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="ti ti-alert-triangle me-1"></i>
                    {{ __('Supprimer un flux supprime aussi toutes les cartes qu\'il a collectées, avec leurs commentaires, favoris et marquages de lecture. La suppression est définitive.', 'veilletool') }}
                </div>

                <form method="post" action="{{ list_url }}" class="d-flex flex-wrap gap-2 align-items-center">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="q" value="{{ search.keyword }}">
                    <input type="hidden" name="cat" value="{{ search.category }}">
                    <input type="hidden" name="active" value="{{ search.active }}">
                    <input type="hidden" name="cards" value="{{ search.volume }}">

                    <span class="text-secondary flex-fill">
                        {% if has_search %}
                            {# « Flux » est invariable : pas de forme plurielle à distinguer. #}
                            {{ __('La recherche en cours retient %d flux.', 'veilletool')|format(sources|length) }}
                        {% else %}
                            {{ __('Aucun critère de recherche : la suppression filtrée porterait sur l\'ensemble des flux.', 'veilletool') }}
                        {% endif %}
                    </span>

                    <button type="submit" name="count_sources" value="1" class="btn btn-outline-secondary">
                        <i class="ti ti-calculator me-1"></i>{{ __('Compter', 'veilletool') }}
                    </button>

                    <button type="submit" name="purge_sources" value="1" class="btn btn-outline-danger"
                            {{ has_search ? '' : 'disabled' }}
                            onclick="return confirm('{{ __('Supprimer les flux retenus par la recherche, ainsi que toutes leurs cartes ? Cette suppression est définitive.', 'veilletool')|e('js') }}');">
                        <i class="ti ti-filter-off me-1"></i>{{ __('Supprimer les flux trouvés', 'veilletool') }}
                    </button>

                    <button type="submit" name="purge_all_sources" value="1" class="btn btn-danger"
                            onclick="return confirm('{{ __('Supprimer LA TOTALITÉ des flux et toutes leurs cartes ? Cette suppression est définitive.', 'veilletool')|e('js') }}');">
                        <i class="ti ti-trash me-1"></i>{{ __('Tout supprimer', 'veilletool') }}
                    </button>
                </form>

                <small class="form-hint mt-2">
                    {{ __('« Compter » n\'écrit rien : il annonce le nombre de flux et de cartes que la suppression emporterait. « Tout supprimer » ignore la recherche en cours.', 'veilletool') }}
                </small>
            </div>
        </div>
    {% endif %}

</div>
