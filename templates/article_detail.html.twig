{#
 # Plugin GLPI « Outils de Veille » (veilletool)
 # Détail d'une carte : contenu complet, provenance et commentaires.
 #}

{% import 'components/form/fields_macros.html.twig' as fields %}

{% set list_url = path('/plugins/veilletool/front/article.php') %}
{% set form_url = path('/plugins/veilletool/front/article.form.php') %}

<div class="veille-detail">

    <div class="mb-3">
        <a class="btn btn-ghost-secondary" href="{{ list_url }}">
            <i class="ti ti-arrow-left me-1"></i>{{ __('Retour à la liste', 'veilletool') }}
        </a>
    </div>

    <div class="card mb-3">
        {% if card.image_url is not empty %}
            <img class="card-img-top veille-detail-img" src="{{ card.image_url }}" alt="">
        {% endif %}

        <div class="card-body">
            <div class="mb-2">
                {% for category in card.categories %}
                    <span class="badge veille-badge" style="background-color: {{ category.color }}; color: {{ category.text_color }}">
                        <i class="{{ category.icon }}"></i>{{ category.name }}
                    </span>
                {% else %}
                    <span class="badge bg-secondary-lt">{{ __('Sans catégorie', 'veilletool') }}</span>
                {% endfor %}
            </div>

            <h1 class="h2">{{ card.name }}</h1>

            <div class="text-secondary mb-3">
                <i class="ti {{ card.is_manual ? 'ti-pencil' : 'ti-rss' }} me-1"></i>{{ card.source_name }}
                · {{ card.origin_label }}
                {% if card.author is not empty %} · {{ card.author }}{% endif %}
                · {{ card.date_published|formatted_datetime }}
                {% if card.date_creation %}
                    <span class="ms-2 small">
                        ({{ __('collectée le', 'veilletool') }} {{ card.date_creation|formatted_datetime }})
                    </span>
                {% endif %}
            </div>

            {# Provenance : lien vers la source, ou mention d'import manuel #}
            <div class="alert {{ card.url is not empty ? 'alert-secondary' : 'alert-warning' }} d-flex align-items-center">
                {% if card.url is not empty %}
                    <i class="ti ti-external-link me-2"></i>
                    <span>
                        {{ __('Source de l\'information :', 'veilletool') }}
                        <a href="{{ card.url }}" target="_blank" rel="noopener noreferrer">{{ card.url }}</a>
                    </span>
                {% else %}
                    <i class="ti ti-pencil me-2"></i>
                    <span>
                        {{ __('Import manuel : aucune adresse source n\'est associée à cette carte.', 'veilletool') }}
                    </span>
                {% endif %}
            </div>

            {# ------------------------------------------------------------ #}
            {# Analyse : score d'intérêt et technologies reconnues            #}
            {#                                                                #}
            {# L'observatoire se parcourt, le détail se lit : c'est ici que    #}
            {# le détail du calcul et la confiance des rapprochements ont      #}
            {# leur place.                                                     #}
            {# ------------------------------------------------------------ #}
            <div class="row g-3 mb-3">
                <div class="col-12 col-lg-6">
                    <div class="card card-sm h-100">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="ti ti-adjustments-star me-1"></i>{{ __('Score d\'intérêt', 'veilletool') }}
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="veille-card-score px-0 pb-2">
                                <span class="badge veille-priority"
                                      style="background-color: {{ card.priority.color }}; color: {{ card.priority.text_color }}">
                                    <i class="{{ card.priority.icon }} me-1"></i>{{ card.priority.label }}
                                </span>
                                <span class="veille-score-value text-secondary">{{ card.interest_score }}<small>/100</small></span>
                                <span class="veille-score-bar" aria-hidden="true">
                                    <span class="veille-score-fill"
                                          style="width: {{ card.interest_score }}%; background-color: {{ card.priority.color }}"></span>
                                </span>
                            </div>

                            <table class="table table-sm table-vcenter mb-0">
                                <thead>
                                    <tr>
                                        <th>{{ __('Composante', 'veilletool') }}</th>
                                        <th class="text-end">{{ __('Note', 'veilletool') }}</th>
                                        <th class="text-end">{{ __('Poids', 'veilletool') }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for part in card.score_detail %}
                                        <tr>
                                            <td>{{ part.label }}</td>
                                            <td class="text-end">{{ part.value }}</td>
                                            <td class="text-end text-secondary">{{ part.weight }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card card-sm h-100">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="ti ti-binary-tree me-1"></i>{{ __('Technologies reconnues', 'veilletool') }}
                            </h3>
                        </div>
                        <div class="card-body">
                            {% if card.technologies is empty %}
                                <p class="text-secondary mb-0">
                                    {{ __('Aucune technologie du référentiel n\'a été reconnue dans cette carte.', 'veilletool') }}
                                </p>
                            {% else %}
                                <div class="veille-card-techs mb-2">
                                    {% for technology in card.technologies %}
                                        <span class="veille-tech-chip {{ technology.is_manual ? 'veille-tech-manual' : '' }}"
                                              title="{{ technology.categorie }} › {{ technology.famille }}{{ technology.name ? ' › ' ~ technology.name : '' }}{{ technology.is_manual ? ' - ' ~ __('rattachement ajouté à la main', 'veilletool') : '' }}">
                                            {% if technology.is_manual %}
                                                <i class="ti ti-hand-finger"></i>
                                            {% endif %}
                                            <a href="{{ list_url }}?{{ {
                                                'view': 'cards',
                                                'tech': (technology.name ? 'name:' ~ technology.name : 'famille:' ~ technology.famille)
                                            }|url_encode }}" class="veille-tech-label text-reset">{{ technology.label }}</a>
                                            <span class="veille-tech-confidence"
                                                  data-veille-confidence="{{ technology.confidence >= 90
                                                      ? 'high' : (technology.confidence >= 60 ? 'medium' : 'low') }}">
                                                {{ technology.confidence }}
                                            </span>
                                            {% if can_classify and technology.is_manual %}
                                                <form method="post" action="{{ form_url }}" class="d-inline">
                                                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                                    <input type="hidden" name="articles_id" value="{{ card.id }}">
                                                    <button type="submit" name="remove_technology" value="{{ technology.id }}"
                                                            class="veille-tech-remove"
                                                            title="{{ __('Retirer ce rattachement', 'veilletool') }}">
                                                        <i class="ti ti-x"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </span>
                                    {% endfor %}
                                </div>
                                <small class="form-hint">
                                    {{ __('Le nombre est la confiance du rapprochement : 100 pour un libellé cité mot pour mot, 90 pour une version tronquée, 85 pour un alias, 60 pour une famille, 50 pour une racine de produit.', 'veilletool') }}
                                </small>
                            {% endif %}

                            {#
                             # Le rapprochement automatique ne voit que ce qui
                             # est écrit. L'administrateur du référentiel
                             # tranche quand le texte ne suffit pas : il
                             # choisit une entrée, et la famille comme la
                             # catégorie en découlent.
                             #}
                            {% if can_classify %}
                                <form method="post" action="{{ form_url }}" class="mt-3 pt-3 border-top">
                                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="articles_id" value="{{ card.id }}">

                                    {{ fields.dropdownField(
                                        'GlpiPlugin\\Veilletool\\Technology',
                                        'technologies_id',
                                        0,
                                        __('Ajouter une technologie', 'veilletool'),
                                        {
                                            'entity_restrict': -1,
                                            'addicon': false,
                                            'displaywith': ['famille', 'categorie'],
                                            'field_class': 'col-12',
                                            'label_class': 'col-12',
                                            'input_class': 'col-12',
                                            'helper': __('La famille et la catégorie viennent de l\'entrée choisie. La confiance vaut 100. Le reclassement automatique ne remet pas ce rattachement en cause.', 'veilletool')
                                        }
                                    ) }}

                                    <button type="submit" name="add_technology" value="1"
                                            class="btn btn-sm btn-outline-primary">
                                        <i class="ti ti-plus me-1"></i>{{ __('Rattacher', 'veilletool') }}
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="veille-content">
                {# Les liens du contenu ouvrent un nouvel onglet : ils
                   renvoient hors de GLPI, et on ne doit pas perdre la carte
                   qu'on est en train de lire. #}
                {% if card.content is not empty %}
                    {{ card.content_html|default(card.content)|safe_html }}
                {% elseif card.summary is not empty %}
                    <p>{{ card.summary }}</p>
                {% else %}
                    <p class="text-secondary">{{ __('Aucun contenu détaillé n\'a été fourni.', 'veilletool') }}</p>
                {% endif %}
            </div>
        </div>

        <div class="card-footer d-flex flex-wrap align-items-center gap-2">
            <form method="post" action="{{ form_url }}" class="d-inline">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="articles_id" value="{{ card.id }}">
                <button type="submit" name="toggle_read" value="1" class="btn btn-sm btn-outline-secondary">
                    <i class="ti {{ card.is_read ? 'ti-mail' : 'ti-mail-opened' }} me-1"></i>
                    {{ card.is_read ? __('Marquer comme non lue', 'veilletool') : __('Marquer comme lue', 'veilletool') }}
                </button>
            </form>

            {% if can_update %}
                <form method="post" action="{{ form_url }}" class="d-inline">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="articles_id" value="{{ card.id }}">
                    <button type="submit" name="toggle_favorite" value="1"
                            class="btn btn-sm {{ card.is_favorite ? 'btn-warning' : 'btn-outline-warning' }}">
                        <i class="ti {{ card.is_favorite ? 'ti-star-filled' : 'ti-star' }} me-1"></i>
                        {{ card.is_favorite ? __('Retirer des favoris', 'veilletool') : __('Ajouter aux favoris', 'veilletool') }}
                    </button>
                </form>

                <a class="btn btn-sm btn-outline-secondary" href="{{ form_url }}?id={{ card.id }}&edit=1">
                    <i class="ti ti-edit me-1"></i>{{ __('Modifier', 'veilletool') }}
                </a>
            {% endif %}

            <button class="btn btn-sm btn-outline-primary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#veille-ai-card-{{ card.id }}">
                <i class="ti ti-sparkles me-1"></i>{{ __('Préparer une question à l\'IA', 'veilletool') }}
            </button>

            {% if can_purge %}
                <form method="post" action="{{ form_url }}" class="d-inline ms-auto"
                      onsubmit="return confirm('{{ __('Supprimer définitivement cette carte ?', 'veilletool')|e('js') }}');">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="id" value="{{ card.id }}">
                    <button type="submit" name="purge" value="1" class="btn btn-sm btn-outline-danger">
                        <i class="ti ti-trash me-1"></i>{{ __('Supprimer', 'veilletool') }}
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    {# ---------------------------------------------------------------- #}
    {# Demander à l'IA                                                   #}
    {# ---------------------------------------------------------------- #}
    <div class="collapse mb-3" id="veille-ai-card-{{ card.id }}">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-sparkles me-1"></i>{{ __('Demander à l\'IA', 'veilletool') }}
                </h3>
            </div>
            <div class="card-body">
                {{ include('@veilletool/parts/ai_composer.html.twig', {
                    'prompts': card.ai_prompts,
                    'level':   ai_level,
                    'url':     card.ai_url,
                    'id':      'card-' ~ card.id,
                }) }}
            </div>
        </div>
    </div>

    {# ---------------------------------------------------------------- #}
    {# Commentaires                                                      #}
    {# ---------------------------------------------------------------- #}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-message-circle me-1"></i>
                {{ _n('%d commentaire', '%d commentaires', comments|length, 'veilletool')|format(comments|length) }}
            </h3>
        </div>

        <div class="card-body">
            {% if comments is empty %}
                <p class="text-secondary">{{ __('Aucun commentaire pour le moment.', 'veilletool') }}</p>
            {% endif %}

            {% for comment in comments %}
                <div class="veille-comment border-bottom pb-3 mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <strong>{{ comment.author_name }}</strong>
                        <span class="text-secondary small">
                            {{ comment.date_creation|formatted_datetime }}
                            {% if comment.is_edited %}
                                · {{ __('modifié', 'veilletool') }}
                                {% if comment.editor_name is not empty %}
                                    {{ __('par', 'veilletool') }} {{ comment.editor_name }}
                                {% endif %}
                                {{ __('le', 'veilletool') }} {{ comment.date_mod|formatted_datetime }}
                            {% endif %}
                        </span>
                    </div>

                    <div class="veille-comment-content">{{ comment.content|nl2br }}</div>

                    {% if comment.can_edit %}
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-sm btn-ghost-secondary" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#veille-comment-edit-{{ comment.id }}">
                                <i class="ti ti-edit me-1"></i>{{ __('Modifier', 'veilletool') }}
                            </button>

                            <form method="post" action="{{ form_url }}" class="d-inline"
                                  onsubmit="return confirm('{{ __('Supprimer ce commentaire ?', 'veilletool')|e('js') }}');">
                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                <input type="hidden" name="comments_id" value="{{ comment.id }}">
                                <button type="submit" name="delete_comment" value="1"
                                        class="btn btn-sm btn-ghost-danger">
                                    <i class="ti ti-trash me-1"></i>{{ __('Supprimer', 'veilletool') }}
                                </button>
                            </form>
                        </div>

                        <div class="collapse mt-2" id="veille-comment-edit-{{ comment.id }}">
                            <form method="post" action="{{ form_url }}">
                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                <input type="hidden" name="comments_id" value="{{ comment.id }}">
                                <textarea name="content" class="form-control mb-2" rows="3"
                                          required>{{ comment.content }}</textarea>
                                <button type="submit" name="update_comment" value="1" class="btn btn-sm btn-primary">
                                    <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
                                </button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}

            {% if can_comment %}
                <form method="post" action="{{ form_url }}">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="articles_id" value="{{ card.id }}">
                    <label class="form-label" for="veille-new-comment">
                        {{ __('Ajouter un commentaire', 'veilletool') }}
                    </label>
                    <textarea id="veille-new-comment" name="content" class="form-control mb-2" rows="3"
                              required placeholder="{{ __('Votre analyse, un point de vigilance, une action à mener...', 'veilletool') }}"></textarea>
                    <button type="submit" name="add_comment" value="1" class="btn btn-primary">
                        <i class="ti ti-send me-1"></i>{{ __('Publier', 'veilletool') }}
                    </button>
                </form>
            {% else %}
                <p class="text-secondary mb-0">
                    {{ __('Vous n\'avez pas le droit d\'ajouter un commentaire.', 'veilletool') }}
                </p>
            {% endif %}
        </div>
    </div>
</div>
